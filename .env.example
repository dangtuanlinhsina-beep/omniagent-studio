# ---------------------------------------------------------------------------
# OmniAgent Studio — frontend (Next.js) configuration example
# Copy to `.env.local`. Only variables prefixed NEXT_PUBLIC_* reach the browser.
# ---------------------------------------------------------------------------

# FastAPI origin used by the BFF route handlers under src/app/api/auth/*.
# Server-side only — deliberately NOT NEXT_PUBLIC_*, so the browser talks to
# this app's origin and never sees the backend directly.
OMNIAGENT_API_URL=http://127.0.0.1:8000

# Optional: WebSocket origin for the browser. Leave empty to use the current
# origin (recommended: terminate /ws/* on the same reverse proxy as the app).
# Example for a separate API host: wss://api.omniagent.example.com
NEXT_PUBLIC_OMNIAGENT_WS_BASE_URL=
# Live WebSocket integration is opt-in; unset/false preserves the mock canvas.
NEXT_PUBLIC_OMNIAGENT_STREAMING=false

# Optional: replace the default Content-Security-Policy from next.config.ts.
# OMNIAGENT_CSP=default-src 'self'; ...

# Prisma (see prisma/schema.prisma). Run: npm run db:generate && npm run db:migrate
DATABASE_URL=postgresql://omniagent:omniagent@127.0.0.1:5432/omniagent
# Comma-separated Prisma log levels; query logging is dev-only by default.
DATABASE_LOG_LEVEL=warn,error
